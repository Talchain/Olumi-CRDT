# Notification Service Configuration

# Service
PORT=3003
NODE_ENV=development

# Redis (for Event Bus)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL (for user preferences and notification history)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olumi_notifications
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Event Bus
STREAM_NAME=olumi:events
CONSUMER_GROUP=notification-service-consumers
CONSUMER_ID=notification-service-1

# Email Provider (Brevo/SendGrid)
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=your-api-key-here
EMAIL_FROM_ADDRESS=noreply@olumi.com
EMAIL_FROM_NAME=Olumi
EMAIL_REPLY_TO=support@olumi.com

# Slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#notifications

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Metrics
METRICS_ENABLED=true

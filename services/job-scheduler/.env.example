# Job Scheduler Service Configuration

# Service
PORT=3002
NODE_ENV=development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# BullMQ
QUEUE_NAME_PREFIX=olumi:jobs
CONCURRENCY=5

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Metrics
METRICS_ENABLED=true

# Job Schedules (override defaults)
# EXPIRE_ACCESS_REQUESTS_CRON=*/5 * * * *
# NOTIFY_EXPIRING_ACCESS_CRON=0 9 * * *
# CLEANUP_OLD_AUDIT_LOGS_CRON=0 2 * * 0
# CLEANUP_EXPIRED_SESSIONS_CRON=0 3 * * *
# GENERATE_DAILY_ANALYTICS_CRON=0 1 * * *

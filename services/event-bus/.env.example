# Event Bus Service Configuration

# Service
PORT=3001
NODE_ENV=development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Streams
STREAM_NAME=olumi:events
CONSUMER_GROUP=event-bus-consumers

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Metrics
METRICS_ENABLED=true

# Olumi Infrastructure Services - Environment Variables

# Email Configuration (Brevo)
EMAIL_API_KEY=your-brevo-api-key-here
EMAIL_FROM_ADDRESS=noreply@olumi.com
EMAIL_FROM_NAME=Olumi

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PostgreSQL (if using external database)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=olumi
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-secure-password

# Redis (if using external Redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# Service Ports (for local development without Docker)
EVENT_BUS_PORT=3001
JOB_SCHEDULER_PORT=3002
NOTIFICATION_SERVICE_PORT=3003
COLLAB_SERVICE_PORT=3000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Node Environment
NODE_ENV=development
